{
  "name": "vetvy",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:editor": "tsc -b && vite build --mode editor",
    "dev:player": "vite --mode player --host 0.0.0.0",
    "publish:story": "node scripts/publish-story.mjs",
    "preview:editor": "vite preview --mode editor --host 127.0.0.1 --port 4174",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.2.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.2.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@xyflow/react": "^12.10.0",
    "dexie": "^4.2.0",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.3"
  }
}
